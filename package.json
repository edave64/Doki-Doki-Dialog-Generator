{
	"name": "doki-doki-dialog-generator",
	"version": "2.6.2",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check \"build:web {@}\" --",
		"preview": "vite preview",
		"test:unit": "vitest",
		"test:visual": "playwright test",
		"test:visual:update": "DDDG_VRT_UPDATE_EXPECTED=1 playwright test",
		"test:visual:install": "playwright install --with-deps",
		"type-check": "vue-tsc --build",
		"lint": "eslint . --fix",
		"format": "prettier --write src/",
		"assetConversions": "node ./scripts/asset-conversions.ts",
		"build:web": "vite build",
		"build:electron": "vite build --mode desktop",
		"sync:release": "rsync -av --delete --exclude=assets/**.webp --exclude=assets/**.png ./dist/ ../dist/release/",
		"sync:pre": "rsync -av --delete --exclude=assets/**.webp --exclude=assets/**.png --exclude=assets/**.txt ./dist/ ../dist/pre/",
		"sync:win": "rsync -av --delete --exclude=assets/**.lq.webp --exclude=assets/**.png ./dist/ ../desktop-win/dddgWeb/",
		"sync:linux": "rsync -av --delete --exclude=assets/**.lq.webp --exclude=assets/**.png ./dist/ ../desktop-linux/dddgWeb/",
		"sync:macos": "rsync -av --delete --exclude=assets/**.lq.webp --exclude=assets/**.png ./dist/ ../desktop/dddgWeb/",
		"update:electron": "npm run build:electron && npm run sync:win & npm run sync:linux"
	},
	"dependencies": {
		"@edave64/dddg-repo-filters": "^0.4.0",
		"@edave64/doki-doki-dialog-generator-pack-format": "^2.0.1",
		"@tauri-apps/api": "^2",
		"jszip": "^3.10.1",
		"mitt": "^3.0.1",
		"pinia": "^4.0.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"vue": "^3.5.42"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@tsconfig/node22": "^22.0.1",
		"@types/jsdom": "^21.1.7",
		"@types/pngjs": "^6.0.5",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitest/eslint-plugin": "^1.6.27",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.10.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-vue": "~10.11.0",
		"jiti": "^2.4.2",
		"jsdom": "^26.0.0",
		"npm-run-all2": "^7.0.2",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.6",
		"sass-embedded": "^1.104.0",
		"ts-essentials": "^10.2.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vitest": "^5.0.0",
		"vue-tsc": "^3.3.11"
	},
	"madge": {
		"detectiveOptions": {
			"ts": {
				"skipTypeImports": true,
				"skipAsyncImports": true
			}
		}
	}
}
